# Copy to .env and fill in real values — never commit .env
# Local Postgres (matches docker-compose.yml) — no ?ssl=require locally
DATABASE_URL=postgresql+asyncpg://eventradar:eventradar@localhost:5432/eventradar
# Neon (production) form — note the required ?ssl=require:
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?ssl=require
SECRET_KEY=change-me-use-python-secrets-token-hex-32
APP_ENV=development

# Fienta ingestion — override to add/remove organizers without touching code
# FIENTA_BASE_URL=https://fienta.com/api/v1/public/events
# KULTUURIKATEL_URL=https://kultuurikatel.ee/en/events/
# FOTOGRAFISKA_URL=https://tallinn.fotografiska.com/en/events
# KUMU_URL=https://kumu.ekm.ee/en/calendar/
# ESTONIA_CONCERT_HALL_URL=https://concert.ee/en/
# PILETILEVI_BASE_URL=https://www.piletilevi.ee  # override for testing
# FIENTA_ORGANIZER_IDS=[3349,1946,15,2111,17595,1088,2704,8403,8412,12106]
# FIENTA_ORGANIZER_NAMES={"3349":"Kanuti Gildi SAAL","1946":"Fotografiska Tallinn","15":"Von Krahli Teater","2111":"Kai kunstikeskus","17595":"Paavli Kultuurivabrik","1088":"Tallinn Fringe Festival","2704":"Kellerteater","8403":"MTÜ Uus Teater","8412":"EKSPEDITSIOON","12106":"Must Kast"}

# Persona affinity vectors — override to retune ranking without code changes
# Keys must match the 14-category / 10-vibe taxonomy (shared/app-config.json) and the
# time slots in app/constants.py (late_night, evening, daytime, morning, weekend, weekday).
# PERSONA_UNDERGROUND_CLUBBER_AFFINITY={"categories":{"music":1.0,"nightlife":1.0,"alternative":0.6},"vibes":{"underground":1.0,"high_energy":0.8,"indie":0.6},"times":{"late_night":1.0,"weekend":0.8}}
# PERSONA_NETWORKING_PRO_AFFINITY={"categories":{"networking":1.0,"workshops":0.5},"vibes":{"trendy":0.8,"accessible":0.6,"educational":0.5},"times":{"weekday":0.8,"evening":0.6}}
# PERSONA_WEEKEND_HOBBYIST_AFFINITY={"categories":{"sports":0.8,"workshops":0.7,"food_drink":0.7},"vibes":{"casual":1.0,"accessible":0.8},"times":{"weekend":1.0,"daytime":0.8}}
# PERSONA_CULTURE_BUFF_AFFINITY={"categories":{"theater":1.0,"exhibitions":1.0,"cinema":0.8,"literature":0.7},"vibes":{"niche":0.7,"indie":0.6,"trendy":0.5}}
# PERSONA_FAMILY_EXPLORER_AFFINITY={"categories":{"family":1.0,"workshops":0.6,"sports":0.4},"vibes":{"accessible":1.0,"casual":0.7,"educational":0.5},"times":{"daytime":0.9,"weekend":0.8}}

# Admin endpoint basic auth — leave empty to disable password check in development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# /internal/tick keepalive — leave empty to skip token validation in development
INTERNAL_TOKEN=

# Email delivery (Resend, needed for auth magic links)
RESEND_API_KEY=
# RESEND_FROM_ADDRESS=What's on Radar <onboarding@resend.dev>
FRONTEND_URL=http://localhost:5173
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_DAYS=7

# Resend inbound-mail webhook secret — the Svix signing secret ("whsec_...") shown on
# this webhook's page in the Resend dashboard; verifies the svix-id/svix-timestamp/
# svix-signature headers over the raw body. Do NOT pass it as a URL query param.
# Leave empty to skip verification (development only).
# RESEND_WEBHOOK_SECRET=

# CORS — JSON array of allowed origins; set to your deployed frontend URL in production
# CORS_ORIGINS=["http://localhost:5173", "http://localhost:4173"]

# LLM providers (needed for Day 8 classification)
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# Logging — LOG_LEVEL applies to the root logger (app, uvicorn, SQL echo).
# LOG_SHIP_URL/LOG_SHIP_TOKEN ship INFO+ logs as JSON to a vendor-agnostic HTTP
# drain (e.g. Axiom) in production; leave empty to log to stdout only.
LOG_LEVEL=INFO
# LOG_SHIP_URL=https://api.axiom.co/v1/datasets/event-radar/ingest
# LOG_SHIP_TOKEN=
