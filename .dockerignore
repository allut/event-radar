# Build context for .devcontainer/Dockerfile is the repo root. Without this,
# ~630 MB / 24k files are tarred to the daemon on every build. The dev
# container Dockerfile COPYs nothing (the repo arrives via bind mount), so
# nothing here is needed at build time.
.git/
backend/venv/
frontend/node_modules/
frontend/dist/
**/__pycache__/
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/
**/*.pyc
.claude/
