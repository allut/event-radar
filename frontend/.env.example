# No client-side env vars needed for dev — Vite proxies /api → http://localhost:8000
# For production builds, set these:
# VITE_API_BASE=https://api.example.com
# VITE_GOOGLE_SIGNIN_ORGANIZER_ENABLED=true  # backend GOOGLE_SIGNIN_ORGANIZER_ENABLED is the authoritative gate — this only avoids rendering a dead button
# VITE_PROMOTIONS_SLOTS_ENABLED=true  # mirrors backend PROMOTIONS_SLOTS_ENABLED: only decides whether /ranking, /faq and /privacy carry the paid-slot copy
# VITE_GOOGLE_SIGNIN_CONSUMER_ENABLED=true  # backend GOOGLE_SIGNIN_CONSUMER_ENABLED is the authoritative gate — this only avoids rendering a dead button
#
# Prerender chain-state manifest (issues #365-#369).
# Build-script vars, not Vite client vars — read by scripts/prerender.ts via src/lib/r2ChainState.ts.
# Optional everywhere: unset, the manifest no-ops and the prerender chain falls back to
# re-fetching production each round. Account id + bucket are non-secret and already live
# in wrangler.toml's [vars]; the two credentials are Cloudflare Pages Secrets in
# production and belong in .env.local (gitignored) locally — never here.
# CLOUDFLARE_ACCOUNT_ID=EXAMPLE_CLOUDFLARE_ACCOUNT_ID
# R2_BUCKET_NAME=EXAMPLE_R2_BUCKET
# R2_ACCESS_KEY_ID=EXAMPLE_R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY=EXAMPLE_R2_SECRET_ACCESS_KEY
