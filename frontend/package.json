{
  "name": "event-radar-frontend",
  "private": true,
  "version": "0.1.25",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html dist/app-shell.html && ([ -z \"$VERCEL$PRERENDER_LOCAL\" ] || (([ -n \"$VERCEL\" ] || playwright install chromium) && tsx scripts/prerender.ts))",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src scripts api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@tanstack/react-query": "^5.56.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "dompurify": "^3.2.6",
    "http-status-codes": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2"
  },
  "overrides": {
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.9",
    "js-yaml": "5.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@sparticuz/chromium": "^147.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "schema-dts": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
