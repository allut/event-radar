    "@vercel/speed-insights": "^2.0.0",
    "dompurify": "^3.2.6",
    "http-status-codes": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2"
  },
  "overrides": {
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.9"
