#!/usr/bin/env bash
# Runs the checks CI also runs, on the areas the commit stages. Enabled by
# .devcontainer/post-create.sh (git config core.hooksPath .githooks).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged() { git diff --cached --name-only --diff-filter=ACMR | grep -qE "$1"; }

if staged '^(shared/|backend/app/_generated/|frontend/src/_generated/)'; then
  echo "pre-commit: generated files"
  python scripts/generate_shared.py --check
fi

if staged '^(backend/|shared/)'; then
  echo "pre-commit: ruff"
  (cd backend && python -m ruff check .)
  echo "pre-commit: mypy"
  (cd backend && python -m mypy app)
fi

if staged '^backend/'; then
  echo "pre-commit: backend guard tests"
  out=$(bash backend/scripts/scratch-test.sh --no-db tests/test_code_rules.py tests/test_constants_unique.py -q 2>&1) || { echo "$out"; exit 1; }
fi

if staged '^(frontend/|shared/)'; then
  echo "pre-commit: eslint"
  (cd frontend && npm run --silent lint)
  echo "pre-commit: type-check"
  (cd frontend && npm run --silent type-check)
fi

if staged '^frontend/src/(.*\.css$|constants/)'; then
  echo "pre-commit: guard tests"
  (cd frontend && npx vitest run src/cssRules.test.ts src/constants/mirrors.test.ts src/displayTokens.test.ts)
fi

if staged '^(CLAUDE\.md|README\.md|docs/)'; then
  echo "pre-commit: docs style"
  out=$(bash backend/scripts/scratch-test.sh tests/test_docs_style.py -q 2>&1) || { echo "$out"; exit 1; }
fi
