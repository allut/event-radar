{
  "name": "Event Radar (Python 3.12 + Node 20 + Postgres 16)",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "app",
  "workspaceFolder": "/workspaces/event-radar",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",

  "features": {
    // 20.x matches CI and satisfies the Node 20.19+ floor of Vite 8 / Vitest 4.
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    // CLI only -- `claude` in the terminal. The feature also contributes the
    // anthropic.claude-code VS Code extension, so it stays out of the list below.
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // 5432 is deliberately absent: the root compose already publishes it to
  // Windows, so DBeaver/psql on the host keep using localhost:5432.
  "forwardPorts": [8000, 5173, 4173],
  "portsAttributes": {
    "8000": { "label": "API (uvicorn)", "onAutoForward": "notify" },
    "5173": { "label": "Frontend (vite dev)", "onAutoForward": "notify" },
    "4173": { "label": "Frontend (vite preview)", "onAutoForward": "silent" }
  },

  // Invoked via bash: the +x bit does not survive a Windows checkout.
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "mounts": [
    // Host Claude Code config, read-only -- the sync script only reads from it.
    "source=${localEnv:USERPROFILE}/.claude,target=/mnt/host-claude,type=bind,readonly",
    // User skills. ~/.claude/skills on the host is 7 NTFS junctions into
    // ~/.agents/skills, and Docker does not follow junctions, so mount the real
    // directory straight onto the container's skills path. Nested inside the
    // claude-code-config volume, which is fine: Docker applies the deeper
    // mount target last.
    "source=${localEnv:USERPROFILE}/.agents/skills,target=/home/vscode/.claude/skills,type=bind,readonly",
    // anvil config (reviewer/roster/caveman choices) and the ccstatusline
    // layout, both read-only sources for the sync script.
    "source=${localEnv:USERPROFILE}/.claude-anvil,target=/mnt/host-anvil,type=bind,readonly",
    "source=${localEnv:USERPROFILE}/.config/ccstatusline,target=/mnt/host-ccstatusline,type=bind,readonly"
  ],

  "postStartCommand": "bash .devcontainer/post-start.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker",
        "tamasfe.even-better-toml",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "python.testing.pytestEnabled": true,
        "python.testing.cwd": "${workspaceFolder}/backend",
        "python.testing.pytestArgs": ["tests"],
        "python.analysis.extraPaths": ["${workspaceFolder}/backend"],

        // Use the pinned ruff 0.15.16 / mypy 2.1.0 from /opt/venv, not the
        // versions bundled with the extensions.
        "ruff.importStrategy": "fromEnvironment",
        "ruff.interpreter": ["/opt/venv/bin/python"],
        "mypy-type-checker.importStrategy": "fromEnvironment",
        "mypy-type-checker.interpreter": ["/opt/venv/bin/python"],
        "mypy-type-checker.cwd": "${workspaceFolder}/backend",

        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": { "source.organizeImports.ruff": "explicit" }
        },

        "eslint.workingDirectories": [
          { "directory": "frontend", "changeProcessCWD": true }
        ],
        "typescript.tsdk": "frontend/node_modules/typescript/lib",

        "files.eol": "\n",
        "files.watcherExclude": {
          "**/node_modules/**": true,
          "**/.mypy_cache/**": true,
          "**/.ruff_cache/**": true,
          "**/.pytest_cache/**": true
        },

        "sqltools.connections": [
          {
            "name": "Event Radar (dev container)",
            "driver": "PostgreSQL",
            "server": "db",
            "port": 5432,
            "database": "eventradar",
            "username": "eventradar",
            "password": "eventradar"
          }
        ]
      }
    }
  }
}
